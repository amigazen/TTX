/*
 * TTX_Exercise.ttx - build a self-checking document while exercising TTX
 *
 * Requires RexxMast, TTX open, rebuilt turbotext.library + TTX.
 *
 *   rx TurboText:Support/TTX_Exercise.ttx
 *   rx TurboText:Support/TTX_Exercise.ttx edit
 *
 * The buffer IS the report. Check PASS/FAIL lines and EXPECTED markers.
 *
 * NoteCmd writes PASS/FAIL at EOF then restores the cursor via an optional
 * Find target (ARG 3) so mid-edit logging does not leave you on the wrong line.
 */

OPTIONS RESULTS

PARSE ARG section
IF section = '' THEN section = 'all'
section = UPPER(STRIP(section))

okcount = 0
failed = 0
host = 'TURBOTEXT'

SAY '=== TTX ARexx exercise ==='
SAY 'host='host 'section='section

CALL DoCmd 'GetVersion'
SAY '  GetVersion RESULT=['RESULT'] RC='RC
verstr = RESULT
IF verstr = '' | UPPER(verstr) = 'RESULT' THEN verstr = '(no RESULT)'

CALL DoCmd 'GetPort'
SAY '  GetPort RESULT=['RESULT'] RC='RC
portstr = RESULT
IF portstr = '' | UPPER(portstr) = 'RESULT' THEN portstr = '(no RESULT)'

CALL DoCmd 'ClearFile'
CALL DoCmd 'MoveSOF'

CALL PutLine '=== TTX ARexx Exercise Report ==='
CALL PutLine 'Inspect this buffer: PASS/FAIL lines and EXPECTED markers.'
CALL PutLine 'Host GetVersion=[' || verstr || ']'
CALL PutLine 'Host GetPort=[' || portstr || ']'
CALL BlankLine

IF section = 'ALL' | section = 'NAV' THEN DO
  SAY '-- navigation --'
  CALL PutLine '--- NAV ---'
  CALL DoCmd 'MoveSOF'
  CALL DoCmd 'MoveEOF'
  CALL DoCmd 'MoveSOL'
  CALL DoCmd 'MoveEOL'
  CALL DoCmd 'MoveRight'
  CALL DoCmd 'MoveLeft'
  CALL DoCmd 'MoveDown'
  CALL DoCmd 'MoveUp'
  CALL DoCmd 'MoveNextWord'
  CALL DoCmd 'MovePrevWord'
  CALL DoCmd 'MoveNextTabStop'
  CALL DoCmd 'MovePrevTabStop'
  CALL DoCmd 'GetCursorPos'
  SAY '  GetCursorPos RESULT=['RESULT']'
  CALL NoteResult 'NAV GetCursorPos', RESULT
  CALL NoteCmd 'NAV SetBookmark', 'SetBookmark 1'
  CALL NoteCmd 'NAV MoveBookmark', 'MoveBookmark 1'
  CALL NoteCmd 'NAV MoveLastChange', 'MoveLastChange'
  CALL NoteCmd 'NAV MoveAutomark', 'MoveAutomark'
  CALL BlankLine
END

IF section = 'ALL' | section = 'EDIT' THEN DO
  SAY '-- edit --'
  CALL GoReportEnd
  CALL PutLine '--- EDIT ---'
  CALL PutLine 'EDIT seed line follows (case transforms apply to it):'
  CALL DoCmd 'InsertLine'
  CALL DoCmd 'Insert "EDIT_MARKER MixedCase Word"'
  CALL DoCmd 'InsertLine'
  CALL DoCmd 'MoveSOF'
  CALL NoteCmd 'EDIT Find seed', 'Find "EDIT_MARKER"', 'EDIT_MARKER'
  CALL DoCmd 'MoveSOL'
  /* Undelete while still on the emptied seed line (NoteCmd MoveEOF would leave junk). */
  CALL DoCmd 'DeleteEOL'
  CALL NoteCmd 'EDIT UndeleteLine', 'UndeleteLine', 'EDIT_MARKER'
  CALL PutLine 'PASS EDIT DeleteEOL'
  CALL DoCmd 'MoveSOF'
  CALL DoCmd 'Find "EDIT_MARKER"'
  CALL DoCmd 'MoveSOL'
  CALL NoteCmd 'EDIT ToggleCharCase', 'ToggleCharCase', 'EDIT_MARKER'
  CALL NoteCmd 'EDIT Conv2Upper', 'Conv2Upper', 'EDIT_MARKER'
  CALL GoReportEnd
  CALL PutLine 'EXPECTED if stopped before Conv2Lower: EDIT_MARKER MIXEDCASE WORD'
  CALL DoCmd 'MoveSOF'
  CALL DoCmd 'Find "EDIT_MARKER"'
  CALL NoteCmd 'EDIT Conv2Lower', 'Conv2Lower', 'edit_marker'
  CALL GoReportEnd
  CALL PutLine 'EXPECTED seed line: edit_marker mixedcase word'
  CALL DoCmd 'MoveSOF'
  CALL DoCmd 'Find "edit_marker"'
  CALL NoteCmd 'EDIT Center', 'Center', 'edit_marker'
  CALL NoteCmd 'EDIT FormatParagraph', 'FormatParagraph', 'edit_marker'
  CALL NoteCmd 'EDIT MoveLastChange', 'MoveLastChange'
  CALL BlankLine
END

IF section = 'ALL' | section = 'BLOCK' THEN DO
  SAY '-- block / clip --'
  CALL GoReportEnd
  CALL PutLine '--- BLOCK / CLIP ---'
  CALL DoCmd 'InsertLine'
  CALL DoCmd 'Insert "BLOCK_COPY_LINE_A"'
  CALL DoCmd 'InsertLine'
  CALL DoCmd 'Insert "BLOCK_COPY_LINE_B"'
  CALL DoCmd 'InsertLine'
  CALL DoCmd 'MoveSOF'
  CALL NoteCmd 'BLOCK Find A', 'Find "BLOCK_COPY_LINE_A"', 'BLOCK_COPY_LINE_A'
  CALL DoCmd 'MoveSOL'
  CALL NoteCmd 'BLOCK MarkBlk start', 'MarkBlk', 'BLOCK_COPY_LINE_A'
  CALL DoCmd 'MoveDown'
  CALL DoCmd 'MoveEOL'
  CALL NoteCmd 'BLOCK MarkBlk end', 'MarkBlk'
  CALL NoteCmd 'BLOCK CopyBlk', 'CopyBlk'
  CALL GoReportEnd
  CALL DoCmd 'InsertLine'
  CALL DoCmd 'Insert "PASTE_BELOW_SHOULD_DUPLICATE_A_AND_B:"'
  CALL DoCmd 'InsertLine'
  CALL NoteCmd 'BLOCK PasteClip', 'PasteClip'
  CALL GoReportEnd
  CALL PutLine 'EXPECTED: BLOCK_COPY_LINE_A appears twice'
  CALL PutLine 'EXPECTED: BLOCK_COPY_LINE_B appears twice'
  CALL BlankLine
END

IF section = 'ALL' | section = 'SEARCH' THEN DO
  SAY '-- search --'
  CALL GoReportEnd
  CALL PutLine '--- SEARCH ---'
  CALL DoCmd 'InsertLine'
  CALL DoCmd 'Insert "SEARCH_NEEDLE_Alpha stays until FindChange"'
  CALL DoCmd 'InsertLine'
  CALL DoCmd 'MoveSOF'
  CALL NoteCmd 'SEARCH Find', 'Find "SEARCH_NEEDLE_Alpha"', 'SEARCH_NEEDLE_Alpha'
  CALL NoteCmd 'SEARCH MoveAutomark', 'MoveAutomark', 'SEARCH_NEEDLE_Alpha'
  /* Inclusive FindChange (library rebuild): replaces match under cursor. */
  CALL NoteCmd 'SEARCH FindChange', ,
    'FindChange "SEARCH_NEEDLE_Alpha" "SEARCH_NEEDLE_OK"', ,
    'SEARCH_NEEDLE_OK'
  CALL GoReportEnd
  CALL PutLine 'EXPECTED line: SEARCH_NEEDLE_OK stays until FindChange'
  CALL PutLine 'EXPECTED absent: SEARCH_NEEDLE_Alpha'
  CALL BlankLine
END

IF section = 'ALL' | section = 'PREFS' THEN DO
  SAY '-- live prefs --'
  CALL GoReportEnd
  CALL PutLine '--- LIVE PREFS ---'
  CALL NoteCmd 'PREFS SetPrefs Overstrike ON', 'SetPrefs "Overstrike" "ON"'
  CALL DoCmd 'GetPrefs "Overstrike"'
  CALL NoteResult 'PREFS Overstrike', RESULT
  CALL NoteCmd 'PREFS SetPrefs ExpandTabs ON', 'SetPrefs "ExpandTabs" "ON"'
  CALL DoCmd 'GetPrefs "ExpandTabs"'
  CALL NoteResult 'PREFS ExpandTabs', RESULT
  CALL NoteCmd 'PREFS SetPrefs AutoIndent ON', 'SetPrefs "AutoIndent" "ON"'
  CALL DoCmd 'GetPrefs "AutoIndent"'
  CALL NoteResult 'PREFS AutoIndent', RESULT
  CALL NoteCmd 'PREFS SetPrefs WordWrap ON', 'SetPrefs "WordWrap" "ON"'
  CALL NoteCmd 'PREFS SetPrefs RightMargin 40', 'SetPrefs "RightMargin" "40"'
  CALL DoCmd 'GetPrefs "RightMargin"'
  CALL NoteResult 'PREFS RightMargin', RESULT
  CALL NoteCmd 'PREFS SetPrefs TabWidth 4', 'SetPrefs "TabWidth" "4"'
  CALL DoCmd 'MarkBlk Off'
  CALL DoCmd 'InsertLine'
  CALL DoCmd 'Insert "PREFS_CONV    fourspaces"'
  CALL DoCmd 'MoveSOL'
  CALL DoCmd 'MarkBlk'
  CALL DoCmd 'MoveEOL'
  CALL DoCmd 'MarkBlk'
  CALL NoteCmd 'PREFS Conv2Tabs', 'Conv2Tabs', 'PREFS_CONV'
  CALL NoteCmd 'PREFS Conv2Spaces', 'Conv2Spaces', 'PREFS_CONV'
  /* Restore quieter defaults for later sections / interactive use. */
  CALL DoCmd 'SetPrefs "Overstrike" "OFF"'
  CALL DoCmd 'SetPrefs "ExpandTabs" "OFF"'
  CALL DoCmd 'SetPrefs "WordWrap" "OFF"'
  CALL DoCmd 'SetPrefs "RightMargin" "80"'
  CALL DoCmd 'SetPrefs "TabWidth" "8"'
  CALL BlankLine
END

IF section = 'ALL' | section = 'VIEW' THEN DO
  SAY '-- multi-view --'
  CALL GoReportEnd
  CALL PutLine '--- VIEW ---'
  CALL NoteCmd 'VIEW SplitView', 'SplitView'
  CALL NoteCmd 'VIEW SwitchView', 'SwitchView'
  CALL NoteCmd 'VIEW CenterView', 'CenterView'
  CALL NoteCmd 'VIEW SwapViews', 'SwapViews'
  CALL DoCmd 'GetViewInfo'
  SAY '  GetViewInfo RESULT=['RESULT']'
  CALL NoteResult 'VIEW GetViewInfo', RESULT
  CALL BlankLine
END

IF section = 'ALL' | section = 'META' THEN DO
  SAY '-- file meta / window --'
  CALL GoReportEnd
  CALL PutLine '--- META ---'
  CALL DoCmd 'GetFilePath'
  SAY '  GetFilePath RESULT=['RESULT']'
  CALL NoteResult 'META GetFilePath', RESULT
  CALL DoCmd 'GetFileInfo'
  SAY '  GetFileInfo RESULT=['RESULT']'
  CALL NoteResult 'META GetFileInfo', RESULT
  CALL DoCmd 'GetReadOnly'
  SAY '  GetReadOnly RESULT=['RESULT']'
  CALL NoteResult 'META GetReadOnly', RESULT
  CALL NoteCmd 'META UpdateView', 'UpdateView'
  CALL NoteCmd 'META ScrollView', 'ScrollView 0 1'
  CALL NoteCmd 'META SetStatusBar', 'SetStatusBar "TTX status ok"'
  CALL DoCmd 'SetStatusBar'
  CALL BlankLine
END

IF section = 'ALL' | section = 'BLOCK' THEN DO
  /* GetBlk / GetBlkInfo — re-mark a short region after earlier BLOCK section. */
  SAY '-- getblk --'
  CALL GoReportEnd
  CALL PutLine '--- GETBLK ---'
  CALL DoCmd 'MoveSOF'
  CALL DoCmd 'Find "BLOCK_COPY_LINE_A"'
  CALL DoCmd 'MoveSOL'
  CALL DoCmd 'MarkBlk'
  CALL DoCmd 'MoveEOL'
  CALL DoCmd 'MarkBlk'
  CALL DoCmd 'GetBlkInfo'
  SAY '  GetBlkInfo RESULT=['RESULT']'
  CALL NoteResult 'GETBLK GetBlkInfo', RESULT
  CALL DoCmd 'GetBlk'
  SAY '  GetBlk RESULT=['RESULT']'
  CALL NoteResult 'GETBLK GetBlk', RESULT
  CALL DoCmd 'MarkBlk Off'
  CALL BlankLine
END

IF section = 'ALL' | section = 'AREXX' THEN DO
  SAY '-- arexx control --'
  CALL GoReportEnd
  CALL PutLine '--- AREXX ---'
  CALL DoCmd 'GetDocuments'
  SAY '  GetDocuments RESULT=['RESULT']'
  CALL NoteResult 'AREXX GetDocuments', RESULT
  CALL DoCmd 'GetCurrentDir'
  SAY '  GetCurrentDir RESULT=['RESULT']'
  CALL NoteResult 'AREXX GetCurrentDir', RESULT
  CALL DoCmd 'GetPort'
  SAY '  GetPort RESULT=['RESULT']'
  CALL NoteResult 'AREXX GetPort', RESULT
  /* Nested string macro: RexxMast runs it; it talks back to TURBOTEXT. */
  CALL NoteCmd 'AREXX ExecARexxString', 'ExecARexxString "GetVersion"'
  CALL BlankLine
END

IF section = 'ALL' | section = 'MACRO' THEN DO
  SAY '-- recorded macro --'
  CALL GoReportEnd
  CALL PutLine '--- MACRO ---'
  /* DoCmd (not NoteCmd) so PASS PutLine text is not captured into the macro. */
  CALL DoCmd 'RecordMacro QUIET'
  IF RC = 0 THEN CALL PutLine 'PASS MACRO RecordMacro'
  ELSE CALL PutLine 'FAIL MACRO RecordMacro RC=' || RC
  CALL DoCmd 'Insert "MACRO_REC_A"'
  CALL DoCmd 'InsertLine'
  CALL DoCmd 'Insert "MACRO_REC_B"'
  CALL DoCmd 'InsertLine'
  CALL DoCmd 'EndMacro'
  IF RC = 0 THEN CALL PutLine 'PASS MACRO EndMacro'
  ELSE CALL PutLine 'FAIL MACRO EndMacro RC=' || RC
  CALL DoCmd 'GetMacroInfo'
  SAY '  GetMacroInfo RESULT=['RESULT']'
  CALL NoteResult 'MACRO GetMacroInfo', RESULT
  CALL DoCmd 'PlayMacro 1'
  IF RC = 0 THEN CALL PutLine 'PASS MACRO PlayMacro'
  ELSE CALL PutLine 'FAIL MACRO PlayMacro RC=' || RC
  CALL BlankLine
END

IF section = 'ALL' | section = 'CTRL' | section = 'MISC' THEN DO
  SAY '-- control / misc --'
  CALL GoReportEnd
  CALL PutLine '--- CTRL ---'

  CALL DoCmd 'GetBackground'
  SAY '  GetBackground RESULT=['RESULT']'
  CALL NoteResult 'CTRL GetBackground', RESULT
  CALL NoteCmd 'CTRL SetBackground', 'SetBackground ON'
  CALL DoCmd 'GetBackground'
  CALL NoteResult 'CTRL GetBackground after ON', RESULT
  CALL DoCmd 'SetBackground OFF'

  CALL DoCmd 'GetPriority'
  SAY '  GetPriority RESULT=['RESULT']'
  CALL NoteResult 'CTRL GetPriority', RESULT

  CALL DoCmd 'GetARexxCache'
  SAY '  GetARexxCache RESULT=['RESULT']'
  CALL NoteResult 'CTRL GetARexxCache', RESULT
  CALL NoteCmd 'CTRL SetARexxCache', 'SetARexxCache OFF'
  CALL DoCmd 'GetARexxCache'
  CALL NoteResult 'CTRL GetARexxCache after OFF', RESULT
  CALL DoCmd 'SetARexxCache ON'
  CALL NoteCmd 'CTRL FlushARexxCache', 'FlushARexxCache'

  CALL DoCmd 'GetLockInfo'
  SAY '  GetLockInfo RESULT=['RESULT']'
  CALL NoteResult 'CTRL GetLockInfo', RESULT
  CALL NoteCmd 'CTRL SetDisplayLock', 'SetDisplayLock ON'
  CALL NoteCmd 'CTRL SetInputLock', 'SetInputLock ON'
  CALL DoCmd 'GetLockInfo'
  CALL NoteResult 'CTRL GetLockInfo locked', RESULT
  CALL DoCmd 'SetInputLock OFF'
  CALL DoCmd 'SetDisplayLock OFF'
  CALL DoCmd 'GetLockInfo'
  CALL NoteResult 'CTRL GetLockInfo unlocked', RESULT

  CALL NoteCmd 'CTRL SetQuoteMode', 'SetQuoteMode ON'
  CALL DoCmd 'SetQuoteMode OFF'
  CALL NoteCmd 'CTRL SetMeta', 'SetMeta ON'
  CALL DoCmd 'SetMeta OFF'
  CALL NoteCmd 'CTRL SetMeta2', 'SetMeta2 ON'
  CALL DoCmd 'SetMeta2 OFF'
  CALL NoteCmd 'CTRL SetMode', 'SetMode ON'
  CALL DoCmd 'SetMode OFF'
  CALL NoteCmd 'CTRL SetMode2', 'SetMode2 ON'
  CALL DoCmd 'SetMode2 OFF'

  CALL DoCmd 'GetErrorInfo'
  SAY '  GetErrorInfo RESULT=['RESULT']'
  CALL NoteResult 'CTRL GetErrorInfo', RESULT

  /* Macro file round-trip on T: (no ASL). Quote path: ARexx treats T: as a symbol. */
  CALL DoCmd 'RecordMacro QUIET'
  CALL DoCmd 'Insert "CTRL_MACRO_LINE"'
  CALL DoCmd 'InsertLine'
  CALL DoCmd 'EndMacro'
  CALL NoteCmd 'CTRL SaveMacro', 'SaveMacro QUIET "T:TTX_CtrlMacro.ttx"'
  CALL DoCmd 'OpenMacro "T:TTX_CtrlMacro.ttx"'
  IF RC = 0 THEN CALL PutLine 'PASS CTRL OpenMacro'
  ELSE CALL PutLine 'FAIL CTRL OpenMacro RC=' || RC
  CALL DoCmd 'GetMacroInfo'
  CALL NoteResult 'CTRL GetMacroInfo after OpenMacro', RESULT
  CALL NoteCmd 'CTRL CloseRequester', 'CloseRequester'

  CALL BlankLine
END

IF section = 'ALL' | section = 'DICT' | section = 'TMPL' THEN DO
  SAY '-- dictionary / templates --'
  CALL GoReportEnd
  CALL PutLine '--- DICT/TMPL ---'

  CALL DoCmd 'CorrectWordCase "amiga"'
  SAY '  CorrectWordCase RESULT=['RESULT']'
  CALL NoteResult 'DICT CorrectWordCase', RESULT
  IF RESULT = 'Amiga' THEN CALL PutLine 'PASS DICT CorrectWordCase RESULT'
  ELSE CALL PutLine 'FAIL DICT CorrectWordCase RESULT'

  CALL DoCmd 'CorrectWord "true"'
  SAY '  CorrectWord true RESULT=['RESULT']'
  CALL NoteResult 'DICT CorrectWord true', RESULT
  IF RESULT = 'TRUE' THEN CALL PutLine 'PASS DICT CorrectWord true'
  ELSE CALL PutLine 'FAIL DICT CorrectWord true'

  CALL DoCmd 'MoveEOF'
  CALL DoCmd 'InsertLine'
  CALL DoCmd 'Insert "amiga"'
  CALL NoteCmd 'DICT CorrectWordCase interactive', 'CorrectWordCase'
  CALL DoCmd 'GetWord'
  CALL NoteResult 'DICT GetWord after case', RESULT

  CALL DoCmd 'MoveEOF'
  CALL DoCmd 'InsertLine'
  CALL DoCmd 'Insert "if"'
  CALL NoteCmd 'TMPL CompleteTemplate', 'CompleteTemplate'
  CALL DoCmd 'CompleteTemplate "if"'
  SAY '  CompleteTemplate RESULT=['RESULT']'
  CALL NoteResult 'TMPL CompleteTemplate ARexx', RESULT

  CALL BlankLine
END

/*
 * PRINT section disabled: PRT: Write often times out / hangs on this setup
 * and stalls the exercise. Commands still exist (PrintFile / PrintClip QUIET).
 *
IF section = 'ALL' | section = 'PRINT' THEN DO
  SAY '-- print (PRT:) --'
  CALL GoReportEnd
  CALL PutLine '--- PRINT ---'
  CALL DoCmd 'MoveSOF'
  CALL DoCmd 'Find "BLOCK_COPY_LINE_A"'
  CALL DoCmd 'MoveSOL'
  CALL DoCmd 'MarkBlk'
  CALL DoCmd 'MoveEOL'
  CALL DoCmd 'MarkBlk'
  CALL DoCmd 'CopyBlk'
  CALL DoCmd 'MarkBlk Off'
  ADDRESS VALUE host
  INTERPRET 'PrintClip QUIET'
  IF RC = 0 THEN DO
    okcount = okcount + 1
    SAY '  OK    PrintClip QUIET'
    CALL PutLine 'PASS PRINT PrintClip'
  END
  ELSE DO
    SAY '  SKIP PrintClip QUIET RC=' || RC || ' (PRT: may be unavailable)'
    CALL PutLine 'NOTE PRINT PrintClip SKIPPED RC=' || RC
  END
  ADDRESS VALUE host
  INTERPRET 'PrintFile QUIET'
  IF RC = 0 THEN DO
    okcount = okcount + 1
    SAY '  OK    PrintFile QUIET'
    CALL PutLine 'PASS PRINT PrintFile'
  END
  ELSE DO
    SAY '  SKIP PrintFile QUIET RC=' || RC || ' (PRT: may be unavailable)'
    CALL PutLine 'NOTE PRINT PrintFile SKIPPED RC=' || RC
  END
  CALL BlankLine
END
 */

CALL GoReportEnd
CALL DoCmd 'InsertLine'
CALL PutLine '=== SUMMARY ==='
CALL PutLine 'Shell tally: ok=' || okcount || ' failed=' || failed
IF failed = 0 THEN
  CALL PutLine 'VERDICT: ALL PASS - check EXPECTED markers match the buffer'
ELSE
  CALL PutLine 'VERDICT: FAILURES - search FAIL lines and missing EXPECTED text'
CALL PutLine '=== end of report ==='

CALL DoCmd 'MoveSOF'
CALL DoCmd 'UpdateView'

SAY '=== TTX ARexx exercise done ==='
SAY 'ok='okcount 'failed='failed
SAY 'Inspect the TTX document window for PASS/FAIL and EXPECTED markers.'
EXIT 0

/* ---------- helpers ---------- */

BlankLine: PROCEDURE EXPOSE host okcount failed RC
  ADDRESS VALUE host
  INTERPRET 'MoveEOF'
  INTERPRET 'InsertLine'
  RETURN

GoReportEnd: PROCEDURE EXPOSE host okcount failed RC
  ADDRESS VALUE host
  INTERPRET 'MoveEOF'
  RETURN

/*
 * Always start a new line at EOF so PASS/FAIL never append mid-line.
 * Do not EXPOSE RESULT — that shadows ARexx RESULT and clobbers it on RETURN.
 */
PutLine: PROCEDURE EXPOSE host okcount failed RC
  PARSE ARG text
  ADDRESS VALUE host
  INTERPRET 'MoveEOF'
  INTERPRET 'InsertLine'
  IF text ~= '' THEN DO
    INTERPRET 'Insert "' || text || '"'
    INTERPRET 'InsertLine'
  END
  RETURN

DoCmd: PROCEDURE EXPOSE host okcount failed RC
  PARSE ARG cmdline
  cmdline = STRIP(cmdline)
  IF cmdline = '' THEN RETURN ''
  ADDRESS VALUE host
  INTERPRET cmdline
  /* Capture host RESULT before we touch RC checks; RETURN it so CALL DoCmd sets caller's RESULT. */
  cmdres = RESULT
  IF RC = 0 THEN DO
    okcount = okcount + 1
    SAY '  OK   ' cmdline
  END
  ELSE DO
    failed = failed + 1
    SAY '  FAIL RC=' || RC || '  ' cmdline
  END
  RETURN cmdres

/*
 * ARG(1)=label  ARG(2)=cmdline  ARG(3)=optional Find restore token
 * Saves RC before PutLine (Insert would clobber RC to 0).
 */
NoteCmd: PROCEDURE EXPOSE host okcount failed RC
  label = ARG(1)
  cmdline = STRIP(ARG(2))
  restore = ARG(3)
  cmdrc = 10
  cmdres = ''

  IF cmdline = '' THEN DO
    failed = failed + 1
    SAY '  FAIL (empty cmdline) ' label
    CALL PutLine 'FAIL ' || label || ' (empty cmdline)'
    RETURN ''
  END

  ADDRESS VALUE host
  INTERPRET cmdline
  cmdrc = RC
  cmdres = RESULT

  IF cmdrc = 0 THEN DO
    okcount = okcount + 1
    SAY '  OK   ' cmdline
    CALL PutLine 'PASS ' || label
  END
  ELSE DO
    failed = failed + 1
    SAY '  FAIL RC=' || cmdrc || '  ' cmdline
    CALL PutLine 'FAIL ' || label || ' RC=' || cmdrc
  END

  IF restore ~= '' THEN DO
    ADDRESS VALUE host
    INTERPRET 'MoveSOF'
    INTERPRET 'Find "' || restore || '"'
  END
  RETURN cmdres

NoteResult: PROCEDURE EXPOSE host okcount failed RC
  label = ARG(1)
  value = ARG(2)
  /* PutLine wraps Insert "..."; strip quotes so RESULT text survives. */
  value = TRANSLATE(value, '"', "'")
  IF value = '' | UPPER(value) = 'RESULT' THEN
    CALL PutLine 'NOTE ' || label || ' RESULT=(empty)'
  ELSE
    CALL PutLine 'NOTE ' || label || ' RESULT=[' || value || ']'
  RETURN
