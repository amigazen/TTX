#
# ttxreqs.library - LVO shared library (asyncio pattern)
#

NAME = ttxreqs.library

OPTIMIZE = optimize opttime
DEBUG = symbolflush noopt

CFLAGS = resopt idlen=64 comnest streq strmerge nostkchk \
	includedir=include includedir=/SDK/Include_h includedir=include: \
	$(OPTIMIZE) debug=$(DEBUG) \
	params=register strsect=code mccons smallcode smalldata \
	unsignedchars nomultipleincludes structureequivalence \
	optimizescheduler noversion noicons memorysize=huge \
	stringsconst nostartup
LFLAGS = addsym smallcode smalldata noicons batch stripdebug

OBJS = \
	StartUp.o \
	LibInit.o \
	tr_mem.o \
	tr_reqsui.o \
	tr_prefs.o \
	tr_info.o

all: $(NAME)

$(NAME): $(OBJS)
	Sc $(LFLAGS) NOSTARTUP LINK TO $@ $(OBJS)

clean:
	delete $(NAME) $(NAME).debug $(NAME).map $(OBJS)

LibInit.o: LibInit.c compiler.h private/tr_build.h Rev.h
	Sc $(CFLAGS) DEF TR_SHARED_LIB UTILLIB OBJNAME $@ LibInit.c

StartUp.o: StartUp.c compiler.h private/tr_build.h tr_funcs.h
	Sc $(CFLAGS) DEF TR_SHARED_LIB UTILLIB OBJNAME $@ StartUp.c

tr_mem.o: tr_mem.c private/tr_internal.h
	Sc $(CFLAGS) DEF TR_SHARED_LIB UTILLIB OBJNAME $@ tr_mem.c

tr_reqsui.o: tr_reqsui.c private/tr_internal.h tr_funcs.h
	Sc $(CFLAGS) DEF TR_SHARED_LIB UTILLIB OBJNAME $@ tr_reqsui.c

tr_prefs.o: tr_prefs.c private/tr_internal.h tr_funcs.h
	Sc $(CFLAGS) DEF TR_SHARED_LIB UTILLIB OBJNAME $@ tr_prefs.c

tr_info.o: tr_info.c private/tr_internal.h tr_funcs.h
	Sc $(CFLAGS) DEF TR_SHARED_LIB UTILLIB OBJNAME $@ tr_info.c
